
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Web server port. Most hosts inject this themselves.
PORT=8787
PG_SSL_MODE=auto
# SUPABASE_CA_CERT=/absolute/path/to/prod-ca-2021.crt

# Postgres connection pool size.
PG_POOL_MAX=8

# OPTIONAL — a Bangladesh Railway e-ticket session token (JWT).
BR_TOKEN=

# OPTIONAL — the device the session token was issued to. Bangladesh Railway

BR_DEVICE_ID=
BR_DEVICE_KEY=

# OPTIONAL — routes to seed the availability watchlist with, "From>To" pairs.
BR_WATCH=Dhaka>Sreemangal

# OPTIONAL — the SHARED Telegram bot, for sale-open alarms.

TELEGRAM_BOT_TOKEN=

PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# Set to 1 to force long-polling even when PUBLIC_BASE_URL is set (local dev
# against a deployed URL, for instance).
TELEGRAM_POLLING=

# OPTIONAL — override the seat-release time (Dhaka, HH:MM:SS).
# Default 08:00:00. Normally leave this alone: with a session token the app
# measures the real release time each day and uses that instead.
BR_SALE_OPEN_TIME=

NODE_ENV=development
