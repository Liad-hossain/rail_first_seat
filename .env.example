
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Web server port. Most hosts inject this themselves.
PORT=8787

# TLS to Postgres: auto (default) | require | strict | disable
#   auto    encrypt for remote hosts, plaintext for localhost
#   require encrypt, do not verify the certificate chain
#   strict  encrypt and verify — also set SUPABASE_CA_CERT
#   disable no TLS (local development only)
PG_SSL_MODE=auto
# SUPABASE_CA_CERT=/absolute/path/to/prod-ca-2021.crt

# Postgres connection pool size.
PG_POOL_MAX=8

# OPTIONAL — a Bangladesh Railway e-ticket session token (JWT).
# Live seat counts and history recording need one; everything else works
# without it. Easiest route is the website's Settings panel, which stores it in
# the database. See the README for how to obtain it.
BR_TOKEN=

# OPTIONAL — the device the session token was issued to. Bangladesh Railway
# ties a session to the browser fingerprint it was created in, so a token
# without its device id is refused exactly as if it had expired. The Settings
# panel captures both together; these are only for env-based deployments.
#   deviceId  = localStorage "uudid"   deviceKey = localStorage "ssdk"
BR_DEVICE_ID=
BR_DEVICE_KEY=

# OPTIONAL — routes to seed the availability watchlist with, "From>To" pairs.
BR_WATCH=Dhaka>Sreemangal

# OPTIONAL — Telegram bot token, for sale-open alarms.
# Normally you do NOT set this: paste the token from @BotFather into the
# Alarms panel in the website instead, which verifies it and stores it in the
# database. This variable is only a fallback for deployments that prefer to
# inject secrets as environment variables. A token saved in the UI wins.
TELEGRAM_BOT_TOKEN=

# OPTIONAL — serverless (Netlify) only.
# PUBLIC_BASE_URL is the site's own https origin. When it is set, saving a bot
# token registers a Telegram WEBHOOK instead of relying on the long-poll loop,
# because a function has nowhere to hold a poll open. Netlify injects this as
# URL automatically, so you normally only need the secret.
# TELEGRAM_WEBHOOK_SECRET is echoed back by Telegram and verified on every
# update — without it the webhook refuses everything. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# Set to 1 to force long-polling even when PUBLIC_BASE_URL is set (local dev
# against a deployed URL, for instance).
TELEGRAM_POLLING=

# OPTIONAL — override the seat-release time (Dhaka, HH:MM:SS).
# Default 08:00:00. Normally leave this alone: with a session token the app
# measures the real release time each day and uses that instead.
BR_SALE_OPEN_TIME=

NODE_ENV=development
